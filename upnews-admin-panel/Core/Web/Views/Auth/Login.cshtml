@using upnews_admin_panel.Core.Web.ViewModels
@{
    Layout = null;
}
@model LoginViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UpNews - Panel de Administración</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1E3A8A;
            --light-blue: #EFF6FF;
            --dark-blue: #1E40AF;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            min-height: 100vh;
        }

        .login-container {
            width: 100%;
            max-width: 470px;
            padding: 20px;
        }

        .login-card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            background: white;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            padding: 40px;
            overflow: hidden;
        }

        .login-header-section {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo-icon {
            font-size: 56px;
            line-height: 1;
            margin-bottom: 16px;
        }

        .login-header-section h1 {
            font-size: 38px;
            font-weight: 700;
            margin: 0;
            color: var(--primary-blue);
        }

        .login-header-section p {
            font-size: 14px;
            color: #666;
            margin-top: 8px;
            margin-bottom: 0;
        }

        .login-form {
            display: flex;
            flex-direction: column;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            display: block;
        }

        .form-control {
            padding: 12px 14px;
            border: 1.5px solid #ddd;
            border-radius: 6px;
            font-size: 15px;
            transition: all 0.25s ease;
            width: 100%;
        }

        .form-control:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px var(--light-blue);
            outline: none;
        }

        .form-control::placeholder {
            color: #999;
            font-weight: 500;
        }

        .form-check {
            margin-bottom: 24px;
            display: flex;
            align-items: center;
        }

        .form-check-input {
            width: 18px;
            height: 18px;
            border: 1.5px solid #ddd;
            border-radius: 4px;
            cursor: pointer;
            accent-color: var(--primary-blue);
            margin-right: 8px;
        }

        .form-check-input:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 3px var(--light-blue);
        }

        .form-check-label {
            font-size: 14px;
            color: #555;
            cursor: pointer;
            user-select: none;
            margin: 0;
        }

        .btn-login {
            width: 100%;
            padding: 12px 16px;
            background-color: var(--primary-blue);
            border: none;
            border-radius: 6px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .btn-login:hover {
            background-color: var(--dark-blue);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(30, 58, 138, 0.3);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .alert {
            border: none;
            border-radius: 6px;
            margin-bottom: 20px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 500;
        }

        .alert-danger {
            background-color: #fee;
            color: #c33;
            border-left: 4px solid #c33;
        }

        @@media (max-width: 480px) {
            .login-container {
                max-width: 100%;
            }

            .login-card {
                padding: 30px;
            }

            .login-header-section h1 {
                font-size: 28px;
            }

            .login-header-section {
                margin-bottom: 25px;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <!-- Header Section -->
            <div class="login-header-section">
                <div class="logo-icon">📰</div>
                <h1>UpNews</h1>
                <p>Panel de Administración</p>
            </div>

            <!-- Form Section -->
            <form asp-controller="Auth" asp-action="Login" method="post" novalidate class="login-form">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <!-- Alerts -->
            @if (!ViewData.ModelState.IsValid)
            {
                @foreach(var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="alert alert-danger">
                        @error.ErrorMessage
                    </div>
                }
            }

            <!-- Email Input -->
            <div class="form-group">
                <label for="username" class="form-label">Correo Electrónico</label>
                <input 
                    type="email" 
                    id="username"
                    name="username" 
                    class="form-control" 
                    placeholder="tu@email.com"
                    required
                    autocomplete="email" />
            </div>

            <!-- Password Input -->
            <div class="form-group">
                <label for="password" class="form-label">Contraseña</label>
                <input 
                    type="password" 
                    id="password"
                    name="password" 
                    class="form-control" 
                    placeholder="Tu contraseña"
                    required
                    autocomplete="current-password" />
            </div>


            <!-- Remember Me -->
            <!-- Remember Me -->
            <div class="form-check">
                <input 
                    asp-for="RememberMe"
                    class="form-check-input" />
                <label class="form-check-label" asp-for="RememberMe">
                    Recuérdame
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-login">
                Acceder
            </button>
        </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>