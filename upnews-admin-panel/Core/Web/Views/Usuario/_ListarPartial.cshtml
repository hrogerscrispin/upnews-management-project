@using upnews_admin_panel.Core.Domain.Models
@model List<Usuario>

<style>
    .usuarios-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .usuario-card {
        background: white;
        border: 1px solid var(--gray-border);
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .usuario-card:hover {
        box-shadow: 0 4px 16px rgba(0, 102, 204, 0.12);
        border-color: var(--primary-blue);
        transform: translateY(-2px);
    }

    .usuario-menu-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: var(--text-secondary);
        padding: 4px 8px;
        transition: color 0.2s ease;
        z-index: 100;
    }

    .usuario-menu-btn:hover {
        color: var(--primary-blue);
    }

    .item-menu-dropdown {
        position: absolute;
        top: 40px;
        right: 0;
        background: white;
        border: 1px solid var(--gray-border);
        border-radius: 6px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        min-width: 160px;
        z-index: 1000;
        display: none;
    }

    .item-menu-dropdown.show {
        display: block;
    }

    .item-menu-item {
        display: block;
        width: 100%;
        padding: 12px 16px;
        border: none;
        background: none;
        text-align: left;
        font-size: 14px;
        color: var(--text-primary);
        cursor: pointer;
        transition: background-color 0.2s ease;
        font-family: inherit;
    }

    .item-menu-item:first-child { border-radius: 6px 6px 0 0; }
    .item-menu-item:last-child  { border-radius: 0 0 6px 6px; }

    .item-menu-item:hover {
        background-color: var(--gray-light);
    }

    .item-menu-item.danger { color: #d32f2f; }
    .item-menu-item.danger:hover { background-color: rgba(211, 47, 47, 0.1); }

    .usuario-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: var(--primary-blue);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        margin-bottom: 16px;
    }

    .usuario-nombre {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .usuario-email {
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: 8px;
        word-break: break-word;
    }

    .usuario-rol {
        font-size: 12px;
        font-weight: 600;
        color: var(--primary-blue);
        background-color: var(--light-blue);
        padding: 4px 8px;
        border-radius: 4px;
        display: inline-block;
        margin-bottom: 12px;
    }

    .usuario-status {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .empty-state {
        text-align: center;
        padding: 64px 32px;
        grid-column: 1 / -1;
    }

    .empty-state-icon   { font-size: 48px; color: var(--gray-border); margin-bottom: 16px; }
    .empty-state-title  { font-size: 18px; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; }
    .empty-state-desc   { font-size: 14px; color: #999; }

    .usuarios-header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
</style>

<div>
    <div class="usuarios-header-section">
        <h2 class="section-title">Gestión de Usuarios</h2>
        <button class="btn-action"
                onclick="abrirPanel('@Url.Action("FormCrear", "Usuario")', 'Nuevo usuario')">
            + Nuevo usuario
        </button>
    </div>

    <div class="usuarios-grid" id="usuariosGrid">
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">👥</div>
                <div class="empty-state-title">No hay usuarios</div>
                <div class="empty-state-desc">Crea el primer usuario para comenzar</div>
            </div>
        }
        else
        {
            @foreach (var usuario in Model)
            {
                var iniciales = (usuario.Nombre ?? "U")
                    .Split(' ')
                    .Where(x => !string.IsNullOrEmpty(x))
                    .Select(x => x[0].ToString().ToUpper())
                    .Take(2)
                    .Aggregate((a, b) => a + b);

                <div class="usuario-card">

                    <button class="usuario-menu-btn" 
                            data-menu-trigger
                            onclick="toggleMenu(this)">⋮</button>

                    <div class="item-menu-dropdown">
                        <button class="item-menu-item"
                                onclick="abrirPanel('@Url.Action("FormEditar", "Usuario", new { id = usuario.Id })', 'Editar usuario')">
                            Editar
                        </button>
                        <button class="item-menu-item danger"
                                onclick="eliminarUsuario('@usuario.Id', '@usuario.Nombre')">
                            Eliminar
                        </button>
                    </div>

                    <div class="usuario-avatar">@iniciales</div>
                    <div class="usuario-nombre">@usuario.Nombre</div>
                    <div class="usuario-email">@usuario.Correo</div>
                    <div class="usuario-rol">
                        @(string.IsNullOrEmpty(usuario.Rol?.Nombre) ? "Sin rol" : usuario.Rol.Nombre)
                    </div>
                    <div class="usuario-status">
                        @if (usuario.Activo.HasValue && usuario.Activo.Value)
                        {
                            <span style="color: #2e7d32;">✓ Activo</span>
                        }
                        else
                        {
                            <span style="color: #c2185b;">✗ Inactivo</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>