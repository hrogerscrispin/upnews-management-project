@using upnews_admin_panel.Core.Domain.Models
@model List<Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1E3A8A;
            --light-blue: #EFF6FF;
            --dark-blue: #1E40AF;
            --gray-light: #f5f5f5;
            --gray-border: #e0e0e0;
            --text-primary: #333;
            --text-secondary: #666;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #ffffff;
            color: var(--text-primary);
        }

        .header {
            background: linear-gradient(135deg, #1E3A8A 0%, #1E40AF 100%);
            color: white;
            padding: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        .header-title {
            font-size: 24px;
            font-weight: 700;
        }

        .btn-back {
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            border: 1px solid white;
            padding: 10px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }

        .btn-back:hover {
            background-color: rgba(255, 255, 255, 0.3);
            color: white;
            text-decoration: none;
        }

        .container-main {
            padding: 32px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .usuarios-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .usuario-card {
            background: white;
            border: 1px solid var(--gray-border);
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            transition: all 0.25s ease;
            display: flex;
            flex-direction: column;
        }

        .usuario-card:hover {
            box-shadow: 0 4px 16px rgba(0, 102, 204, 0.12);
            border-color: var(--primary-blue);
            transform: translateY(-2px);
        }

        .usuario-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: var(--primary-blue);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
            margin-bottom: 16px;
        }

        .usuario-nombre {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .usuario-email {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 4px;
            word-break: break-word;
        }

        .usuario-rol {
            font-size: 12px;
            font-weight: 600;
            color: var(--primary-blue);
            background-color: var(--light-blue);
            padding: 4px 8px;
            border-radius: 4px;
            display: inline-block;
            margin-bottom: 16px;
        }

        .usuario-status {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .usuario-actions {
            display: flex;
            gap: 8px;
            margin-top: auto;
        }

        .btn-card {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid var(--gray-border);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            background: white;
            color: var(--text-primary);
        }

        .btn-card:hover {
            background-color: var(--gray-light);
        }

        .btn-card.danger {
            color: #d32f2f;
            border-color: #d32f2f;
        }

        .btn-card.danger:hover {
            background-color: rgba(211, 47, 47, 0.1);
        }

        .btn-card.primary {
            background-color: var(--primary-blue);
            color: white;
            border-color: var(--primary-blue);
        }

        .btn-card.primary:hover {
            background-color: var(--dark-blue);
        }

        .empty-state {
            text-align: center;
            padding: 64px 32px;
        }

        .empty-state-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        .empty-state-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .empty-state-description {
            font-size: 14px;
            color: #999;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1 class="header-title">Gestión de Usuarios</h1>
        <a href="@Url.Action("Index", "Dashboard")" class="btn-back">← Volver al Dashboard</a>
    </div>

    <div class="container-main">
        <div class="usuarios-grid">
            @if (Model == null || Model.Count == 0)
            {
                <div class="empty-state" style="grid-column: 1 / -1;">
                    <div class="empty-state-icon">👥</div>
                    <div class="empty-state-title">No hay usuarios</div>
                    <div class="empty-state-description">Crea el primer usuario para comenzar</div>
                </div>
            }
            else
            {
                @foreach (var usuario in Model)
                {
                    var iniciales = (usuario.Nombre ?? "U")
                        .Split(' ')
                        .Where(x => !string.IsNullOrEmpty(x))
                        .Select(x => x[0].ToString().ToUpper())
                        .Take(2)
                        .Aggregate((a, b) => a + b);

                    <div class="usuario-card">
                        <div class="usuario-avatar">@iniciales</div>
                        <div class="usuario-nombre">@usuario.Nombre</div>
                        <div class="usuario-email">@usuario.Correo</div>
                        <div class="usuario-rol">@(string.IsNullOrEmpty(usuario.RolId) ? "Sin rol" : "Rol: " + usuario.RolId)</div>
                        <div class="usuario-status">
                            @if (usuario.Activo.HasValue && usuario.Activo.Value)
                            {
                                <span style="color: #2e7d32;">✓ Activo</span>
                            }
                            else
                            {
                                <span style="color: #c2185b;">✗ Inactivo</span>
                            }
                        </div>
                        <div class="usuario-actions">
                            <button class="btn-card primary" onclick="alert('Editar: @usuario.Id')">Editar</button>
                            <button class="btn-card danger" onclick="if(confirm('¿Estás seguro?')) alert('Eliminar: @usuario.Id')">Eliminar</button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
